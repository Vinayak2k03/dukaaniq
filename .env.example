# Copy to .env and fill in real values. NEVER commit .env.
# All variables are server-only (no NEXT_PUBLIC_ prefix).

# Neon pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection (no "-pooler"). Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Public base URL of the app (http://localhost:3000 in development)
BETTER_AUTH_URL="http://localhost:3000"

# Optional. Sarvam AI key for message wording; without it, fixed templates are used.
# Create one at https://indus.sarvam.ai/key-management (server-only, never commit a real value).
SARVAM_API_KEY=""

# Sarvam models (defaults shown). Chat: customer wording + "why" text; reasoning: voice/feedback parsing.
SARVAM_CHAT_MODEL="sarvam-105b-conversations"
SARVAM_REASONING_MODEL="sarvam-105b"
# Speech to text (voice commands) and text to speech (read-back). Browser speech is the fallback.
SARVAM_STT_MODEL="saaras:v3"
SARVAM_TTS_MODEL="bulbul:v3"
# Optional Bulbul voice; leave empty for the API default.
SARVAM_TTS_SPEAKER=""
# Max LLM calls per growth-tips session; beyond it templates are used silently.
SARVAM_MAX_CALLS_PER_SESSION="6"
# Margin floor for discounts and combos: price after discount >= cost x (1 + MIN_MARGIN_PCT/100).
MIN_MARGIN_PCT="5"
