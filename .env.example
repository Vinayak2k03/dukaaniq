# Copy to .env and fill in real values. NEVER commit .env.
# All variables are server-only (no NEXT_PUBLIC_ prefix).

# Neon pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection (no "-pooler"). Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Public base URL of the app (http://localhost:3000 in development)
BETTER_AUTH_URL="http://localhost:3000"

# Optional. Sarvam AI key for message wording; without it, fixed templates are used.
# Create one at https://indus.sarvam.ai/key-management (server-only, never commit a real value).
SARVAM_API_KEY=""
